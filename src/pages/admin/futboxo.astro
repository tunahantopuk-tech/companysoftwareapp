---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Futboxo Yönetimi" description="Futboxo admin">
  <div class="wrap">
    <header class="top">
      <a href="/admin/dashboard" class="geri">← Panel</a>
      <h1>Futboxo Yönetimi</h1>
      <span id="yazmaDurum" class="rozet">…</span>
    </header>

    <nav class="sekmeler">
      <button class="sekme aktif" data-sekme="duyuru">Duyuru &amp; Kontrol</button>
      <button class="sekme" data-sekme="transfer">Transfer &amp; Oyuncu</button>
      <button class="sekme" data-sekme="kullanici">Oyuncular &amp; Moderasyon</button>
    </nav>

    <!-- ── DUYURU & KONTROL ─────────────────────────────────────────────── -->
    <section id="duyuru" class="panel">
      <div class="kart uyari" id="kapiUyari" hidden>
        <strong>Dikkat:</strong> Sürüm kapısı açıkken belirttiğin sürümün ALTINDAKİ
        tüm kullanıcılar oyunu açamaz, güncelleme ekranı görür. Yalnızca kritik
        hatalarda kullan.
      </div>

      <div class="kart">
        <h2>Zorunlu Güncelleme</h2>
        <p class="ipucu">Boş bırakırsan kapı kapalıdır — kimse kilitlenmez.</p>
        <label>Minimum sürüm
          <input id="minVersion" placeholder="örn. 1.5 — boş = kapalı" />
        </label>
        <label>Kullanıcıya gösterilecek mesaj
          <textarea id="updateMessage" rows="2" placeholder="Eşleşme hatası giderildi, lütfen güncelle."></textarea>
        </label>
      </div>

      <div class="kart">
        <h2>Bakım Modu</h2>
        <label class="satir">
          <input type="checkbox" id="maintenance" />
          <span>Bakım modunu aç (herkes bakım ekranı görür)</span>
        </label>
        <label>Bakım mesajı
          <textarea id="maintenanceMessage" rows="2" placeholder="Kısa bir bakım yapıyoruz, birazdan döneceğiz."></textarea>
        </label>
      </div>

      <!-- ── TAM EKRAN DUYURU ─────────────────────────────────────────── -->
      <div class="kart">
        <h2>Tam Ekran Duyuru</h2>
        <p class="ipucu">
          Oyun açılınca ekranın tamamını kaplayan kart. Büyük duyurular için.
        </p>
        <label class="satir">
          <input type="checkbox" id="fsAcik" />
          <span>Tam ekran duyuru göster</span>
        </label>
        <div id="fsAlan">
          <div class="ikili">
            <label>Kimlik (id)
              <input id="fsId" placeholder="tam-ekran-2026-09" />
            </label>
            <label>Gösterim sıklığı
              <select id="fsFreq">
                <option value="once">Bir kez göster</option>
                <option value="always">Her açılışta göster</option>
                <option value="interval">Belirli aralıkla göster</option>
              </select>
            </label>
          </div>
          <label id="fsIntervalAlan">Kaç dakikada bir göstersin
            <input id="fsInterval" type="number" min="1" step="1" value="60" />
          </label>
          <label>Başlık<input id="fsTitle" placeholder="Yeni Sezon Başladı" /></label>
          <label>Metin<textarea id="fsBody" rows="3" placeholder="193 takım ve 11 lig logosuyla güncellendi."></textarea></label>
          <label>Görsel adresi (opsiyonel)<input id="fsImage" placeholder="https://www.companysoftware.app/futboxo/..." /></label>
          <div class="ikili">
            <label>Buton yazısı (opsiyonel)<input id="fsBtnText" placeholder="İncele" /></label>
            <label>Buton adresi (opsiyonel)<input id="fsBtnUrl" placeholder="https://..." /></label>
          </div>
          <label class="satir">
            <input type="checkbox" id="fsDismiss" checked />
            <span>Kapatılabilir olsun (kapatılamaz bırakmak App Store kuralına takılabilir)</span>
          </label>
          <label class="satir">
            <input type="checkbox" id="fsAyricaSerit" />
            <span>Kapatılınca ana sayfada ince şerit olarak da kalsın</span>
          </label>
        </div>
      </div>

      <!-- ── İNCE ŞERİT DUYURU ────────────────────────────────────────────── -->
      <div class="kart">
        <h2>İnce Şerit Duyuru</h2>
        <p class="ipucu">
          Ana sayfada, oyun kartlarının üstünde duran ince satır.
          <strong>Tam ekrandan bağımsızdır</strong> — ikisine farklı metin yazabilirsin,
          ikisi aynı anda yayında olabilir. Şerit kalıcıdır: kullanıcı kapatana kadar durur,
          o yüzden “sıklık” ayarı yoktur.
        </p>
        <label class="satir">
          <input type="checkbox" id="stAcik" />
          <span>İnce şerit duyuru göster</span>
        </label>
        <div id="stAlan">
          <div class="ikili">
            <label>Kimlik (id)
              <input id="stId" placeholder="serit-2026-09" />
            </label>
            <label>Kapatınca
              <select id="stFreq">
                <option value="once">Bir daha çıkmasın</option>
                <option value="always">Sonraki açılışta yine çıksın</option>
              </select>
            </label>
          </div>
          <label>Başlık<input id="stTitle" placeholder="Topluluk Logo Paketi v3.0" /></label>
          <label>Metin<textarea id="stBody" rows="2" placeholder="193 takım + 11 lig logosu hazır."></textarea></label>
          <label>Görsel adresi (opsiyonel)<input id="stImage" placeholder="https://www.companysoftware.app/futboxo/..." /></label>
          <div class="ikili">
            <label>Buton yazısı (opsiyonel)<input id="stBtnText" placeholder="Aç" /></label>
            <label>Buton adresi (opsiyonel)<input id="stBtnUrl" placeholder="https://..." /></label>
          </div>
          <label class="satir">
            <input type="checkbox" id="stDismiss" checked />
            <span>Kapatılabilir olsun</span>
          </label>
        </div>
      </div>

      <p class="ipucu">
        ⚠️ <strong>Aynı <code>id</code> gösterim geçmişini taşır.</strong> Duyuruyu bir kez
        kapatmış kullanıcıya aynı id ile bir daha görünmez — yeni duyuru için
        <strong>yeni bir id</strong> ver.
      </p>

      <div class="eylem">
        <button id="kaydetConfig" class="btn">Yayınla</button>
        <button id="kopyalaConfig" class="btn ikincil">JSON'u kopyala</button>
        <span id="configDurum" class="durum"></span>
      </div>
      <pre id="configOnizleme" class="onizleme"></pre>
    </section>

    <!-- ── TRANSFER & OYUNCU ────────────────────────────────────────────── -->
    <section id="transfer" class="panel" hidden>
      <div class="kart">
        <h2>Oyuncu Ara</h2>
        <p class="ipucu">
          En az 3 harf yaz. Bulduğun oyuncuya takım ekleyebilir, yanlış takımı
          çıkarabilir, güncel takımını ve rating'ini düzeltebilirsin.
        </p>
        <input id="arama" placeholder="Rafael Leão, Greenwood, Taffarel..." autocomplete="off" />
        <div id="sonuclar" class="sonuclar"></div>
      </div>

      <div class="kart" id="duzenleKart" hidden>
        <h2 id="duzenleAd">—</h2>
        <p class="ipucu" id="duzenleMevcut"></p>

        <label>Takım ekle
          <input id="takimEkle" list="takimListesi" placeholder="galatasaray" autocomplete="off" />
        </label>
        <datalist id="takimListesi"></datalist>

        <label>Takım çıkar
          <input id="takimCikar" list="takimListesi" placeholder="yanlis_takim" autocomplete="off" />
        </label>

        <div class="ikili">
          <label>Güncel takım (görünen ad)<input id="guncelTakim" placeholder="Galatasaray" /></label>
          <label>Rating (opsiyonel)<input id="rating" type="number" placeholder="84" /></label>
        </div>

        <button id="yamaEkle" class="btn">Listeye ekle</button>
      </div>

      <div class="kart">
        <h2>Bekleyen Yamalar</h2>
        <div id="yamaListe" class="yamalar"></div>
        <div class="eylem">
          <button id="kaydetPatch" class="btn">Yayınla</button>
          <button id="kopyalaPatch" class="btn ikincil">JSON'u kopyala</button>
          <span id="patchDurum" class="durum"></span>
        </div>
        <pre id="patchOnizleme" class="onizleme"></pre>
      </div>
    </section>

    <!-- ── OYUNCULAR & MODERASYON ───────────────────────────────────────── -->
    <section id="kullanici" class="panel" hidden>
      <div class="kart uyari" id="kullaniciKapali" hidden>
        <strong>Kullanıcı yönetimi kapalı.</strong>
        <span id="kullaniciKapaliMetin"></span>
      </div>

      <div class="kart">
        <h2>Durum</h2>
        <div class="sayaclar">
          <div class="sayac"><span id="sayacOnline">–</span><small>çevrimiçi</small></div>
          <div class="sayac"><span id="sayacToplam">–</span><small>toplam oyuncu</small></div>
          <div class="sayac"><span id="sayacBanli">–</span><small>banlı</small></div>
        </div>
        <p class="ipucu">
          Çevrimiçi sayısı son 5 dakika içinde oyunu açık tutan oyuncuları gösterir.
          <button id="yenileOzet" class="btn ikincil ufak">Yenile</button>
        </p>
        <div id="onlineListe" class="onlineListe"></div>
      </div>

      <div class="kart">
        <h2>Oyuncu Ara</h2>
        <p class="ipucu">
          İsmin <strong>başından</strong> yaz (Firestore önek araması). Boş bırakırsan
          en yüksek puanlı oyuncular listelenir.
        </p>
        <input id="kAra" placeholder="Oyuncu adı..." autocomplete="off" />
        <div id="kSonuc" class="kSonuc"></div>
      </div>
    </section>

  </div>
</Layout>

<script>
  // Oturum kontrolü — sunucudan.
  fetch('/api/admin-login').then((r) => { if (!r.ok) location.href = '/admin'; })
    .catch(() => { location.href = '/admin'; });

  const $ = (id: string) => document.getElementById(id) as any;
  let config: any = {};
  let patch: any = { version: 1, patches: [] };
  let oyuncular: any[] = [];
  let takimlar: Record<string, string> = {};
  let seciliOyuncu: any = null;
  let yazilabilir = false;

  // ── Sekmeler ──
  document.querySelectorAll('.sekme').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.sekme').forEach((x) => x.classList.remove('aktif'));
      b.classList.add('aktif');
      const hedef = (b as HTMLElement).dataset.sekme;
      $('duyuru').hidden = hedef !== 'duyuru';
      $('transfer').hidden = hedef !== 'transfer';
    })
  );

  // ── Yükleme ──
  async function yukle(dosya: string) {
    const r = await fetch(`/api/futboxo-admin?dosya=${dosya}`);
    if (!r.ok) throw new Error(`${dosya} okunamadı`);
    const v = await r.json();
    yazilabilir = v.yazilabilir;
    return v.icerik;
  }

  (async () => {
    try {
      config = await yukle('config');
      patch = await yukle('patch');
      configDoldur();
      yamalariCiz();
      $('yazmaDurum').textContent = yazilabilir ? 'Yayınlama açık' : 'Salt okunur (GITHUB_TOKEN yok)';
      $('yazmaDurum').className = 'rozet ' + (yazilabilir ? 'yesil' : 'sari');
    } catch (e: any) {
      $('yazmaDurum').textContent = 'Yüklenemedi';
      $('yazmaDurum').className = 'rozet kirmizi';
    }
    // Oyuncu indeksi (büyük dosya — arka planda)
    try {
      const r = await fetch('/futboxo/players-index.json');
      const v = await r.json();
      oyuncular = v.players;
      takimlar = v.teams;
      const dl = $('takimListesi');
      Object.entries(takimlar).forEach(([id, ad]) => {
        const o = document.createElement('option');
        o.value = id; o.label = ad as string;
        dl.appendChild(o);
      });
    } catch {}
  })();

  // ── Config formu ──
  function configDoldur() {
    $('minVersion').value = config.minVersion || '';
    $('updateMessage').value = config.updateMessage || '';
    $('maintenance').checked = !!config.maintenance;
    $('maintenanceMessage').value = config.maintenanceMessage || '';
    // Eski tek-duyuru biçimi de okunur: `banner` alanı veya tek elemanlı `banners`.
    const hepsi = [
      ...(Array.isArray(config.banners) ? config.banners : []),
      ...(config.banner ? [config.banner] : []),
    ];
    const bicim = (b: any) => (b.style === 'small' ? 'strip' : b.style || 'strip');
    const fs = hepsi.find((b: any) => ['fullscreen', 'both'].includes(bicim(b)));
    const st = hepsi.find((b: any) => ['strip', 'both'].includes(bicim(b)));

    $('fsAcik').checked = !!fs;
    if (fs) {
      $('fsId').value = fs.id || '';
      $('fsFreq').value = fs.frequency || 'once';
      $('fsInterval').value = fs.intervalMinutes || 60;
      $('fsTitle').value = fs.title || ''; $('fsBody').value = fs.body || '';
      $('fsImage').value = fs.imageURL || ''; $('fsBtnText').value = fs.buttonText || '';
      $('fsBtnUrl').value = fs.buttonURL || ''; $('fsDismiss').checked = fs.dismissible !== false;
      $('fsAyricaSerit').checked = bicim(fs) === 'both';
    }
    // "both" ise şerit bloğu ayrı bir duyuru DEĞİL, aynı duyurunun şerit hâli.
    const stAyri = st && st !== fs;
    $('stAcik').checked = !!stAyri;
    if (stAyri) {
      $('stId').value = st.id || '';
      $('stFreq').value = st.frequency === 'always' ? 'always' : 'once';
      $('stTitle').value = st.title || ''; $('stBody').value = st.body || '';
      $('stImage').value = st.imageURL || ''; $('stBtnText').value = st.buttonText || '';
      $('stBtnUrl').value = st.buttonURL || ''; $('stDismiss').checked = st.dismissible !== false;
    }
    configGuncelle();
  }

  function configTopla() {
    const c: any = {
      minVersion: $('minVersion').value.trim(),
      updateMessage: $('updateMessage').value.trim(),
      maintenance: $('maintenance').checked,
      maintenanceMessage: $('maintenanceMessage').value.trim(),
      // Eski tekil alan artık YAZILMIYOR (null kalıyor); uygulama ikisini de
      // okuyor, böylece elle yazılmış eski dosyalar da bozulmuyor.
      banner: null,
      banners: [],
    };

    if ($('fsAcik').checked) {
      const b: any = {
        id: $('fsId').value.trim() || 'tam-ekran-' + Date.now(),
        // "Kapatılınca şerit olarak kalsın" işaretliyse tek duyuru iki yerde görünür.
        style: $('fsAyricaSerit').checked ? 'both' : 'fullscreen',
        frequency: $('fsFreq').value,
        title: $('fsTitle').value.trim(),
        body: $('fsBody').value.trim(),
        dismissible: $('fsDismiss').checked,
      };
      if (b.frequency === 'interval') {
        b.intervalMinutes = Math.max(1, parseInt($('fsInterval').value, 10) || 60);
      }
      if ($('fsImage').value.trim()) b.imageURL = $('fsImage').value.trim();
      if ($('fsBtnText').value.trim()) b.buttonText = $('fsBtnText').value.trim();
      if ($('fsBtnUrl').value.trim()) b.buttonURL = $('fsBtnUrl').value.trim();
      c.banners.push(b);
    }

    if ($('stAcik').checked) {
      const b: any = {
        id: $('stId').value.trim() || 'serit-' + Date.now(),
        style: 'strip',
        frequency: $('stFreq').value,
        title: $('stTitle').value.trim(),
        body: $('stBody').value.trim(),
        dismissible: $('stDismiss').checked,
      };
      if ($('stImage').value.trim()) b.imageURL = $('stImage').value.trim();
      if ($('stBtnText').value.trim()) b.buttonText = $('stBtnText').value.trim();
      if ($('stBtnUrl').value.trim()) b.buttonURL = $('stBtnUrl').value.trim();
      c.banners.push(b);
    }
    return c;
  }

  function configGuncelle() {
    const c = configTopla();
    $('configOnizleme').textContent = JSON.stringify(c, null, 1);
    $('kapiUyari').hidden = !c.minVersion;
    $('fsAlan').style.opacity = $('fsAcik').checked ? '1' : '0.4';
    $('stAlan').style.opacity = $('stAcik').checked ? '1' : '0.4';
    // "Kaç dakikada bir" yalnızca aralıklı gösterimde anlamlı.
    $('fsIntervalAlan').style.display = $('fsFreq').value === 'interval' ? '' : 'none';
  }
  $('duyuru').addEventListener('input', configGuncelle);
  $('duyuru').addEventListener('change', configGuncelle);

  // ── Oyuncu arama ──
  let zamanlayici: any;
  $('arama').addEventListener('input', () => {
    clearTimeout(zamanlayici);
    zamanlayici = setTimeout(ara, 180);
  });

  function sadelestir(s: string) {
    return s.toLocaleLowerCase('tr').normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  function ara() {
    const q = sadelestir($('arama').value.trim());
    const kutu = $('sonuclar');
    if (q.length < 3) { kutu.innerHTML = ''; return; }
    const bulunan = oyuncular.filter((p) => sadelestir(p.n).includes(q)).slice(0, 25);
    kutu.innerHTML = bulunan.length ? '' : '<p class="ipucu">Sonuç yok.</p>';
    bulunan.forEach((p) => {
      const d = document.createElement('button');
      d.className = 'sonuc';
      d.innerHTML = `<strong>${p.n}</strong><span>${p.r || '—'} · ${p.c || 'takımsız'}</span>`;
      d.addEventListener('click', () => sec(p));
      kutu.appendChild(d);
    });
  }

  function sec(p: any) {
    seciliOyuncu = p;
    $('duzenleKart').hidden = false;
    $('duzenleAd').textContent = p.n;
    const adlar = p.t.map((t: string) => takimlar[t] || t).join(' · ');
    $('duzenleMevcut').innerHTML =
      `<code>${p.i}</code> — mevcut takımlar: ${adlar || 'yok'}`;
    $('takimEkle').value = ''; $('takimCikar').value = '';
    $('guncelTakim').value = ''; $('rating').value = '';
    $('duzenleKart').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  $('yamaEkle').addEventListener('click', () => {
    if (!seciliOyuncu) return;
    const y: any = { id: seciliOyuncu.i };
    const ekle = $('takimEkle').value.trim();
    const cikar = $('takimCikar').value.trim();
    if (ekle) y.addTeams = [ekle];
    if (cikar) y.removeTeams = [cikar];
    if ($('guncelTakim').value.trim()) y.currentTeam = $('guncelTakim').value.trim();
    if ($('rating').value) y.rating = Number($('rating').value);
    if (Object.keys(y).length === 1) {
      alert('Hiçbir alan doldurulmamış.\n\nTransfer için "Takım ekle" alanına takım id\'sini yaz (örn. galatasaray).');
      return;
    }
    // Transfer girilip güncel takım boş bırakıldıysa hatırlat — kart üzerinde
    // eski takım görünmeye devam eder, kolayca gözden kaçıyor.
    if (y.addTeams && !y.currentTeam &&
        !confirm('Takım eklendi ama "Güncel takım" boş.\n\nOyuncunun kartında hâlâ ESKİ takımı görünecek.\n\nYine de ekleyeyim mi?')) {
      return;
    }

    patch.patches = patch.patches.filter((x: any) => x.id !== y.id);
    patch.patches.push(y);
    yamalariCiz();
    $('duzenleKart').hidden = true;
    seciliOyuncu = null;
    $('arama').value = ''; $('sonuclar').innerHTML = '';
  });

  function yamalariCiz() {
    const kutu = $('yamaListe');
    if (!patch.patches?.length) {
      kutu.innerHTML = '<p class="ipucu">Henüz yama yok.</p>';
    } else {
      kutu.innerHTML = '';
      patch.patches.forEach((y: any, i: number) => {
        const ad = oyuncular.find((p) => p.i === y.id)?.n || y.id;
        const parcalar: string[] = [];
        if (y.addTeams) parcalar.push('+ ' + y.addTeams.join(', '));
        if (y.removeTeams) parcalar.push('− ' + y.removeTeams.join(', '));
        if (y.currentTeam) parcalar.push('güncel: ' + y.currentTeam);
        if (y.rating) parcalar.push('rating: ' + y.rating);
        const d = document.createElement('div');
        d.className = 'yama';
        d.innerHTML = `<div><strong>${ad}</strong><span>${parcalar.join(' · ')}</span></div>`;
        const sil = document.createElement('button');
        sil.textContent = 'Sil'; sil.className = 'sil';
        sil.addEventListener('click', () => { patch.patches.splice(i, 1); yamalariCiz(); });
        d.appendChild(sil);
        kutu.appendChild(d);
      });
    }
    $('patchOnizleme').textContent = JSON.stringify(patch, null, 1);
  }

  // ── Kaydetme ──
  async function yayinla(dosya: string, icerik: any, durumId: string, mesaj: string) {
    const d = $(durumId);
    d.textContent = 'Gönderiliyor...'; d.className = 'durum';
    const r = await fetch('/api/futboxo-admin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dosya, icerik, mesaj }),
    });
    const v = await r.json().catch(() => ({}));
    if (r.ok) {
      d.textContent = `Yayınlandı (${v.commit}). ${v.not || ''}`;
      d.className = 'durum ok';
    } else {
      d.textContent = v.error || 'Hata';
      d.className = 'durum hata';
    }
  }

  $('kaydetConfig').addEventListener('click', () => {
    const c = configTopla();
    if (c.minVersion && !confirm(
      `Sürüm kapısı açılıyor.\n\n${c.minVersion} altındaki TÜM kullanıcılar oyunu açamayacak.\n\nEmin misin?`
    )) return;
    if (c.maintenance && !confirm('Bakım modu açılıyor — herkes bakım ekranı görecek. Emin misin?')) return;
    config = c;
    yayinla('config', c, 'configDurum', 'Futboxo: duyuru/kontrol güncellendi');
  });

  $('kaydetPatch').addEventListener('click', () => {
    patch.version = (Number(patch.version) || 0) + 1;
    yamalariCiz();
    yayinla('patch', patch, 'patchDurum', `Futboxo: oyuncu yaması v${patch.version}`);
  });

  $('kopyalaConfig').addEventListener('click', () =>
    navigator.clipboard.writeText(JSON.stringify(configTopla(), null, 1))
      .then(() => ($('configDurum').textContent = 'Panoya kopyalandı.')));
  $('kopyalaPatch').addEventListener('click', () =>
    navigator.clipboard.writeText(JSON.stringify(patch, null, 1))
      .then(() => ($('patchDurum').textContent = 'Panoya kopyalandı.')));

  // ══ OYUNCULAR & MODERASYON ═══════════════════════════════════════════════
  let kullaniciHazir: boolean | null = null;

  async function kullaniciIstek(yol: string, secenek?: RequestInit) {
    const r = await fetch(yol, secenek);
    const j = await r.json().catch(() => ({}));
    if (r.status === 503) {
      kullaniciHazir = false;
      $('kullaniciKapali').hidden = false;
      $('kullaniciKapaliMetin').textContent = ' ' + (j.hata || '');
      return null;
    }
    if (!r.ok) throw new Error(j.hata || ('HTTP ' + r.status));
    kullaniciHazir = true;
    $('kullaniciKapali').hidden = true;
    return j;
  }

  async function ozetYukle() {
    try {
      const j = await kullaniciIstek('/api/futboxo-users?mod=ozet');
      if (!j) return;
      $('sayacOnline').textContent = j.cevrimici ?? '–';
      $('sayacToplam').textContent = j.toplam ?? '–';
      $('sayacBanli').textContent = j.banli ?? '–';
      const on = await kullaniciIstek('/api/futboxo-users?mod=online');
      const kutu = $('onlineListe');
      kutu.textContent = '';
      if (!on || !on.liste?.length) {
        kutu.textContent = 'Şu an çevrimiçi oyuncu yok.';
        kutu.className = 'onlineListe bos';
        return;
      }
      kutu.className = 'onlineListe';
      on.liste.slice(0, 60).forEach((o: any) => {
        const d = document.createElement('span');
        d.className = 'onlineRozet';
        d.textContent = o.username || o.uid.slice(0, 6);
        kutu.appendChild(d);
      });
    } catch (e: any) {
      $('kullaniciKapali').hidden = false;
      $('kullaniciKapaliMetin').textContent = ' ' + e.message;
    }
  }

  function oyuncuKarti(o: any) {
    const k = document.createElement('div');
    k.className = 'kSatir' + (o.banned ? ' banli' : '');

    const sol = document.createElement('div');
    sol.className = 'kSol';
    const ad = document.createElement('div');
    ad.className = 'kAd';
    ad.textContent = o.username || '(isimsiz)';
    if (o.online) {
      const nokta = document.createElement('span');
      nokta.className = 'nokta'; nokta.title = 'çevrimiçi';
      ad.appendChild(nokta);
    }
    if (o.banned) {
      const r = document.createElement('span');
      r.className = 'banRozet';
      r.textContent = 'BANLI';
      ad.appendChild(r);
    }
    const alt = document.createElement('div');
    alt.className = 'kAlt';
    alt.textContent = `${o.totalPoints} puan · ${o.rankPoints} RP · ${o.coins} coin` +
      (o.isGuest ? ' · misafir' : '') + ` · ${o.uid.slice(0, 10)}…`;
    if (o.banned && o.banReason) alt.textContent += ` · sebep: ${o.banReason}`;
    sol.append(ad, alt);

    const sag = document.createElement('div');
    sag.className = 'kSag';

    const adBtn = document.createElement('button');
    adBtn.className = 'btn ikincil ufak';
    adBtn.textContent = 'İsim değiştir';
    adBtn.onclick = async () => {
      const yeni = prompt(`Yeni isim (3-20 karakter):`, o.username);
      if (!yeni) return;
      await moderasyon(o.uid, 'rename', { yeniAd: yeni.trim() }, k);
    };

    const banBtn = document.createElement('button');
    banBtn.className = 'btn ufak ' + (o.banned ? 'ikincil' : 'tehlike');
    banBtn.textContent = o.banned ? 'Banı kaldır' : 'Banla';
    banBtn.onclick = async () => {
      if (o.banned) {
        if (!confirm(`${o.username} adlı oyuncunun banı kaldırılsın mı?`)) return;
        await moderasyon(o.uid, 'unban', {}, k);
      } else {
        const sebep = prompt(`${o.username} banlanacak. Sebep (oyuncuya gösterilir):`, 'Kural ihlali');
        if (sebep === null) return;
        await moderasyon(o.uid, 'ban', { sebep }, k);
      }
    };

    sag.append(adBtn, banBtn);
    k.append(sol, sag);
    return k;
  }

  async function moderasyon(uid: string, islem: string, ek: any, kart: HTMLElement) {
    const eski = kart.style.opacity;
    kart.style.opacity = '0.5';
    try {
      const j = await kullaniciIstek('/api/futboxo-users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uid, islem, ...ek }),
      });
      if (j?.ok) { kart.replaceWith(oyuncuKarti(j.oyuncu)); ozetYukle(); }
    } catch (e: any) {
      alert('Olmadı: ' + e.message);
      kart.style.opacity = eski;
    }
  }

  async function kullaniciAra() {
    const q = ($('kAra') as HTMLInputElement).value.trim();
    const kutu = $('kSonuc');
    kutu.textContent = 'Aranıyor…';
    try {
      const j = await kullaniciIstek('/api/futboxo-users?q=' + encodeURIComponent(q));
      if (!j) { kutu.textContent = ''; return; }
      kutu.textContent = '';
      if (!j.oyuncular?.length) { kutu.textContent = 'Sonuç yok.'; return; }
      j.oyuncular.forEach((o: any) => kutu.appendChild(oyuncuKarti(o)));
    } catch (e: any) {
      kutu.textContent = 'Hata: ' + e.message;
    }
  }

  let kZaman: any;
  $('kAra').addEventListener('input', () => {
    clearTimeout(kZaman);
    kZaman = setTimeout(kullaniciAra, 250);
  });
  $('yenileOzet').addEventListener('click', ozetYukle);

  // Sekmeye ilk geçişte yükle.
  document.querySelector('[data-sekme="kullanici"]')?.addEventListener('click', () => {
    if (kullaniciHazir === null) { ozetYukle(); kullaniciAra(); }
  });

</script>

