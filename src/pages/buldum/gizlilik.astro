const email = 'support@companysoftware.app';

const sections: LegalSection[] = [
  {
    title: 'Kısa özet',
    html: `<p>Buldum mümkün olan en az veriyle çalışır: reklam yok, üçüncü taraf takip aracı yok, veriler Avrupa Birliği'nde (Frankfurt) tutulur.</p>`,
  },
  {
    title: 'Hangi veriler, neden, ne kadar süre',
    table: {
      head: ['Veri', 'Neden', 'Ne zaman silinir'],
      rows: [
        ['Apple ile Giriş kimliği, e-posta (Apple\'ın gizli e-postası olabilir), görünen ad', 'Hesap açmak ve giriş yapmak', 'Hesap silinince'],
        ['İlan bilgileri (kategori, açıklama, renk, marka, tarih)', 'İlanı yayınlamak ve eşleştirmek', 'İlan kapandıktan 12 ay sonra; hesap silinince'],
