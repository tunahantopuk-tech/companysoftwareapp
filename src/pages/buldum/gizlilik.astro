---
import BuldumLegal from '../../components/BuldumLegal.astro';
import type { LegalSection } from '../../components/BuldumLegal.astro';

const email = 'support@companysoftware.app';

const sections: LegalSection[] = [
  {
    title: 'Kısa özet',
    html: `<p>Buldum mümkün olan en az veriyle çalışır: reklam yok, üçüncü taraf takip aracı yok, veriler Avrupa Birliği'nde (Frankfurt) tutulur.</p>`,
  },
  {
    title: 'Hangi veriler, neden, ne kadar süre',
    table: {
      head: ['Veri', 'Neden', 'Ne zaman silinir'],
      rows: [
        ['Apple ile Giriş ya da Google ile Giriş kimliği, e-posta (Apple\'ın gizli e-postası olabilir), görünen ad', 'Hesap açmak ve giriş yapmak', 'Hesap silinince'],
        ['İlan bilgileri (kategori, açıklama, renk, marka, tarih)', 'İlanı yayınlamak ve eşleştirmek', 'İlan kapandıktan 12 ay sonra; hesap silinince'],
        ['İlan fotoğrafları (yazılar ve yüzler cihazda bulanıklaştırılır, konum bilgisi silinir)', 'İlanı göstermek', 'İlan kapandıktan 90 gün sonra; sahipsiz yüklemeler 48 saat sonra'],
        ['İlan konumu', 'Eşleştirme ve harita', 'Herkese ~300 m yaklaşık gösterilir; kesin konumu ekip dahil kimse göremez'],
        ['Mesajlar', 'Kullanıcıların iletişimi', 'İlgili ilan kapandıktan 12 ay sonra. Hesabını silince gönderdiğin mesajların içeriği silinir; karşı tarafın sana yazdıkları onun geçmişinde kalır. Ekip yalnızca raporlanan mesajları görebilir'],
        ['Bahşiş için paylaşılan ad ve IBAN', 'Kullanıcının kendi isteğiyle bahşiş alabilmesi', 'Şifreli tutulur, 48 saat sonra silinir; yalnızca karşı taraf görür'],
