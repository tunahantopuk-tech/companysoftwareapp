---
import BuldumLegal from '../../components/BuldumLegal.astro';
import type { LegalSection } from '../../components/BuldumLegal.astro';

const email = 'support@companysoftware.app';
const mail = `<a href="mailto:${email}">${email}</a>`;

const sections: LegalSection[] = [
  {
    title: 'Taraflar',
    html: `<p>Bu sözleşme, Buldum mobil uygulamasını ("Uygulama") sunan Company Software ("biz") ile Uygulama'ya üye olan kişi ("Kullanıcı", "sen") arasındadır. İletişim: ${mail}</p>`,
  },
  {
    title: 'Kabul ve yaş',
    html: `<p>Uygulama'yı kullanmak için <strong>18 yaşını doldurmuş olman</strong> gerekir. Üye olurken bu sözleşmeyi okuduğunu ve kabul ettiğini beyan edersin. Üyelik Apple ile Giriş ya da Google ile Giriş üzerinden yapılır; bir kişi tek hesap kullanır.</p>`,
  },
  {
    title: 'Hizmetin niteliği',
    html: `<p>Buldum, bulunan ve kaybedilen eşyalar için ilan verilmesini, ilanların eşleştirilmesini, kullanıcıların mesajlaşmasını ve eşyanın QR kodla ya da bir teslim noktası üzerinden sahibine ulaştırılmasını kolaylaştıran bir <strong>aracı platformdur</strong>. Biz eşyaları teslim almayız, saklamayız, taşımayız; sahiplik konusunda karar vermeyiz.</p>
<p>Teslim noktaları (Metro İstanbul, İETT, havalimanları vb.) bağımsız kurumlardır; onların kuralları ve saatleri geçerlidir. Uygulama'daki rehber ve acil hat bilgileri genel yönlendirme niteliğindedir; resmî kurumun güncel açıklaması esastır.</p>`,
  },
  {
    title: 'Bulunan eşyaya dair yasal yükümlülük',
    html: `<p>Türk Medeni Kanunu'na göre bulunan eşya sahibine ya da kolluk güçlerine bildirilmelidir. Buldum'da ilan vermek bu yükümlülüğün yerini almaz; değerli eşyalar ve kimlik gibi resmî belgeler için resmî bir noktaya teslim etmeni öneririz.</p>`,
  },
  {
    title: 'İlan kuralları',
    html: `<p>İlan verirken şunlara uymayı kabul edersin:</p>
<ol>
  <li>T.C. kimlik, kart ya da hesap (IBAN) numarası paylaşmamak.</li>
  <li>Yüz ve kişisel bilgi içeren fotoğraf koymamak; kimlik, kart, ehliyet ve pasaport ilanlarında fotoğraf kullanılamaz.</li>
  <li>Eşyanın ayırt edici detayını ilana yazmamak; sahibini gizli soruyla doğrulamak.</li>
  <li>Teslimden önce para, ödül ya da kargo ücreti istememek.</li>
  <li>Eşyayı sahibine dürüstçe ulaştırmak; ulaştıramıyorsan resmî bir noktaya bırakmak.</li>
</ol>`,
  },
  {
    title: 'Yasak davranışlar',
    html: `<p>Sahte ilan vermek; başkasının eşyasını sahiplenmeye çalışmak; dolandırıcılık, tehdit, şantaj, taciz, hakaret; Buldum Ekibi'ni ya da bir kurumu taklit etmek; kişisel verileri izinsiz toplamak; Uygulama'yı otomatik araçlarla kullanmak ya da güvenliğini aşmaya çalışmak yasaktır. Bu davranışlar hesabın kapatılmasına ve gerektiğinde yetkili makamlara bildirime yol açabilir.</p>`,
  },
  {
    title: 'Teslim ve güvenlik',
    html: `<p>Elden teslimde kalabalık ve kamuya açık yerlerde buluşmanı öneririz. Buluşmalar senin kararınla ve sorumluluğunda gerçekleşir; tehdit ya da şantajla karşılaşırsan uzaklaş, 112'yi ara ve Uygulama'dan raporla.</p>
<p><strong>Teslim noktaları:</strong> Teslim noktasındaki fiziksel teslim, o kurumun kendi kurallarına bağlıdır; Buldum teslimi garanti etmez ve kurumların işleyişinden sorumlu değildir. Uygulamadaki teslim noktalarının Buldum ile anlaşması yoktur.</p>
<p><strong>"Ben buldum" bildirimi:</strong> Bir Kaybettim ilanına "Ben buldum" bildirimi yalnızca eşyayı gerçekten bulduysan gönderilir. Yanıltıcı bildirim, ilan sahibini buluşmaya ya da ödeme yapmaya yönlendirme girişimi hesabın askıya alınmasına ya da kapatılmasına yol açar.</p>
<p><strong>Doğrulama sorusu:</strong> Bulan kişinin yazdığı doğrulama sorusunu yalnızca eşya sana aitse yanıtla. Başkasına ait eşyayı almak için soruyu tahmin etmeye çalışmak yasaktır; tekrarlanan yanlış denemeler incelenir.</p>`,
  },
  {
    title: 'Teşekkür bahşişi',
    html: `<p>Eşyasını kaybeden kullanıcı, bulan kişiye <strong>isteğe bağlı</strong> bir teşekkür bahşişi teklif edebilir. Bahşiş seçeneği yalnızca doğrulanmış teslimden (QR ile teslim ya da teslim noktasında "Aldım" onayı) sonra açılır. Bulan kişi kabul ederse adını ve IBAN'ını yalnızca o kullanıcıyla, kendi isteğiyle paylaşır; ödeme kullanıcılar arasında kendi bankaları üzerinden yapılır.</p>
<p><strong>Para Buldum'dan geçmez</strong>; Buldum bahşişin ödenip ödenmediğini doğrulamaz, garanti etmez ve bahşişle ilgili uyuşmazlıklarda taraf değildir. Bahşiş bir yükümlülük değil, gönüllü bir teşekkürdür. Kamu hizmeti yerinde ya da işyerinde bulunan eşyalar için o yerin sahibi veya kurum bahşiş talep edemez.</p>
<p><strong>Para güvenliği:</strong> Buldum'da eşya için para istenmez. Kimseye "fazla gelen" parayı iade etme; hesabını başkasının para transferi için kullandırma. Bu tür istekler dolandırıcılık ya da suç olabilir. Buldum bu istekleri içeren mesajları işaretler, 1.000 TL üstü bahşiş tekliflerini kötüye kullanımı önlemek için inceleyebilir ve ilgili hesapları askıya alabilir.</p>`,
  },
  {
    title: 'İyilik Puanı Programı',
    id: 'iyilik-puani',
    html: `<p>Buldum, eşyaları sahibine ulaştıran kullanıcılara teşekkür olarak <strong>İyilik Puanı</strong> verir. Program gönüllü bir teşekkür uygulamasıdır; Company Software programı değiştirebilir, durdurabilir ya da sona erdirebilir. Değişiklikler Uygulama'da duyurulur; o ana kadar kullanılabilir hâle gelmiş puanlar için makul bir kullanım süresi tanınır.</p>
<ul>
<li><strong>Kazanma:</strong> Yeni üyelere 50 puanlık hoş geldin puanı verilir; bu puan, ilk teslim puanın kullanılabilir hâle gelince açılır. Bulduğun eşya doğrulanmış biçimde sahibine ulaştığında (QR ile teslim ya da teslim noktasında sahibin "Aldım" onayı) 100 puan kazanırsın. Puan, bahşiş verilip verilmemesinden bağımsızdır.</li>
<li><strong>Bekleme ve inceleme:</strong> Teslim puanı önce bekleyen olarak yazılır ve 7 gün sonra kullanılabilir olur. Bu sürede bildirim ya da şikâyet gelirse puan, inceleme bitene kadar dondurulur. Kısa sürede gerçekleşen teslimler ve yeni hesaplar ekip incelemesine alınabilir.</li>
<li><strong>Sınırlar:</strong> Aynı iki kullanıcı arasında teslim puanı yalnızca bir kez verilir; bir takvim ayında en fazla 3 teslim puanı kazanılabilir.</li>
<li><strong>Hediye çeki:</strong> En az 250 kullanılabilir puana ulaştığında, puanını bilinen bir alışveriş sitesinin dijital hediye çekine dönüştürmek için talepte bulunabilirsin (250 puan için 250 ₺, 500 puan için 500 ₺ değerinde). Site, stok ve tutar durumuna göre ekibimiz tarafından seçilir. Talepler elle incelenir; aylık kontenjan dolduğunda sıraya alınır. Kod yalnızca Uygulama'daki Kuponlarım bölümünde teslim edilir. Çekin kullanımı ilgili sitenin kendi koşullarına tabidir.</li>
<li><strong>Nitelik:</strong> İyilik Puanı nakde çevrilemez, satılamaz, devredilemez ve başka bir hesapla birleştirilemez; bir ödeme aracı ya da alacak niteliği taşımaz. Kullanılabilir puanlar kazanıldıkları tarihten 12 ay sonra silinir.</li>
<li><strong>Kötüye kullanım:</strong> Sahte ilan, sahte teslim, birden fazla hesap ya da başka hileli yollarla puan toplanması hâlinde puanlar ve açık talepler iptal edilir ve hesap kapatılabilir.</li>
<li><strong>Hesabın kapanması:</strong> Hesabını silersen ya da hesabın kalıcı olarak kapatılırsa puanların ve açık taleplerin sona erer.</li>
</ul>
<p>Güven puanı ve rozetler parasal değer taşımaz ve devredilemez.</p>`,
  },
  {
    title: 'Moderasyon',
    html: `<p>Kurallara aykırı içerikleri kaldırabilir, hesabı uyarabilir, en fazla 7 gün askıya alabilir ya da kalıcı olarak kapatabiliriz. Kalıcı olarak kapatılan hesabın yeniden açılmasını önlemek için Apple ya da Google hesap kimliğinin geri çevrilemez bir özetini saklarız (ayrıntı: <a href="/buldum/gizlilik">Gizlilik Politikası</a>). Karara itiraz için ${mail} adresine yazabilirsin.</p>`,
  },
  {
    title: 'Sorumluluğun sınırları',
    html: `<p>Kullanıcıların verdiği ilanların doğruluğunu, eşyanın bulunmasını, teslimin gerçekleşmesini ya da kullanıcılar arasındaki ilişkileri garanti etmeyiz. Yasal olarak sınırlandırılamayan sorumluluklar saklıdır.</p>`,
  },
  {
    title: 'Hesabın kapatılması',
    html: `<p>Hesabını istediğin an Ayarlar'dan silebilirsin; Apple ile girdiysen silme Apple bağlantısını da iptal eder; Google ile girdiysen Buldum'un erişimini Google hesabının güvenlik ayarlarından da kaldırabilirsin. Saklanması gereken kayıtlar <a href="/buldum/gizlilik">Gizlilik Politikası</a>'ndaki sürelerle sınırlıdır.</p>`,
  },
  {
    title: 'Değişiklikler',
    html: `<p>Sözleşmeyi güncelleyebiliriz; önemli değişikliklerde Uygulama seni bilgilendirir ve yeniden onay ister.</p>`,
  },
  {
    title: 'Uygulanacak hukuk ve uyuşmazlık',
    html: `<p>Türk hukuku uygulanır. Tüketici uyuşmazlıklarında tüketici hakem heyetleri ve tüketici mahkemeleri yetkilidir.</p>`,
  },
];
---

<BuldumLegal
  pageTitle="Buldum — Kullanıcı Sözleşmesi"
  heading="Kullanıcı Sözleşmesi"
  description="Buldum kayıp ve bulunan eşya uygulaması kullanıcı sözleşmesi."
  intro="Buldum'u kullanırken geçerli olan kurallar, hakların ve sorumluluklarımız."
  version="2026-12"
  lastUpdated="27 Kasım 2026"
  sections={sections}
  current="kullanici-sozlesmesi"
/>
