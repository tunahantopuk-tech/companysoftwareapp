---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const accent = '#B8901F';
const lastUpdated = '12 Kasım 2026';
const contactEmail = 'support@companysoftware.app';

const sections = [
  {
    title: 'Kabul ve Kapsam',
    content: 'iAkçe uygulamasını ("Uygulama") indirip kullanarak bu Kullanım Koşulları\'nı ve Gizlilik Politikası\'nı okuduğunuzu, anladığınızı ve kabul ettiğinizi beyan edersiniz. Bu koşulları kabul etmiyorsanız uygulamayı kullanmayınız. Uygulama Apple App Store aracılığıyla dağıtılmaktadır; Apple\'ın Son Kullanıcı Lisans Sözleşmesi de uygulanır.',
    link: { text: 'Apple EULA ↗', href: 'https://www.apple.com/legal/internet-services/itunes/dev/stdeula/' },
  },
  {
    title: 'Hizmetin Açıklaması',
    content: 'iAkçe, kişisel gelir ve gider takibi, düzenli ödeme hatırlatmaları, kredi ve kredi kartı yönetimi, yatırım portföyü takibi, bütçe ve hedef yönetimi sunan bir iOS uygulamasıdır. Uygulama bir banka, finans kuruluşu veya ödeme hizmeti sağlayıcısı değildir. Hiçbir banka hesabına bağlanmaz, para transferi yapmaz ve sizin adınıza hiçbir finansal işlem gerçekleştirmez. Tüm veriler sizin elle girdiğiniz bilgilerden oluşur.',
  },
  {
    title: 'Finansal Danışmanlık Değildir',
    content: 'Uygulamadaki "Danışman" bölümü ve tüm değerlendirmeler, yalnızca sizin girdiğiniz verilere dayanan otomatik hesaplamalardır. Bu çıktılar bilgilendirme amaçlıdır ve yatırım danışmanlığı, vergi danışmanlığı, hukuki danışmanlık veya finansal planlama hizmeti niteliği taşımaz. Hiçbir varlığın alınması, satılması veya elde tutulması önerilmez. Finansal kararlarınızı kendi değerlendirmenizle ve gerektiğinde yetkili bir uzmana danışarak vermelisiniz. Uygulamadaki bilgilere dayanarak aldığınız kararların sonuçlarından geliştirici sorumlu tutulamaz.',
  },
  {
    title: 'Verilerin Doğruluğu',
    content: 'Uygulamadaki tüm hesaplamalar sizin girdiğiniz verilere dayanır. Yanlış veya eksik veri girişi, yanlış sonuçlar üretir. Kredi taksit planları, ekstre hesapları ve faiz hesaplamaları yaklaşık değerlerdir; bankanızın resmi hesaplamalarıyla farklılık gösterebilir. Resmi tutarlar için her zaman bankanızın kendi bildirimlerini esas alın. Döviz kurları Türkiye Cumhuriyet Merkez Bankası\'nın herkese açık bülteninden alınır ve gecikmeli olabilir.',
  },
  {
    title: 'Verilerinizin Sorumluluğu',
    content: 'Tüm verileriniz yalnızca cihazınızda ve dilerseniz kendi iCloud hesabınızda saklanır. Geliştirici bu verilere erişemez, bu nedenle kaybolan verileri geri getiremez. Cihazınızın kaybı, arızalanması, uygulamanın silinmesi veya iCloud hesabınızla ilgili sorunlar durumunda verilerinizin kurtarılması mümkün olmayabilir. Düzenli olarak uygulama içi yedekleme özelliğini kullanmanızı öneririz.',
  },
  {
    title: 'Kabul Edilebilir Kullanım',
    content: 'Uygulamayı yalnızca kişisel ve yasal amaçlarla kullanabilirsiniz. Uygulamanın kaynak kodunu tersine mühendislikle çözmeye çalışmak, kopyalamak, değiştirmek veya izinsiz dağıtmak yasaktır. Uygulamayı yasa dışı faaliyetlerin kaydı veya planlanması amacıyla kullanamazsınız.',
  },
  {
    title: 'Fikri Mülkiyet',
    content: 'Uygulamanın tasarımı, kaynak kodu, görselleri, metinleri ve markası Company Software\'e aittir ve telif hakkı yasalarıyla korunmaktadır. Uygulamayı kullanmanız size yalnızca kişisel, devredilemez ve münhasır olmayan bir kullanım hakkı verir; mülkiyet hakkı vermez.',
  },
  {
    title: 'Sorumluluk Sınırı',
    content: 'Uygulama "olduğu gibi" sunulmaktadır. Yürürlükteki yasaların izin verdiği azami ölçüde, uygulamanın kesintisiz veya hatasız çalışacağı garanti edilmez. Uygulamanın kullanımından veya kullanılamamasından doğabilecek doğrudan veya dolaylı zararlardan, veri kaybından, kâr kaybından ya da finansal kayıplardan geliştirici sorumlu tutulamaz.',
  },
  {
    title: 'Koşullarda Değişiklik',
    content: 'Bu koşullar zaman zaman güncellenebilir. Önemli değişiklikler uygulama güncellemeleri aracılığıyla duyurulur. Güncellemeden sonra uygulamayı kullanmaya devam etmeniz, yeni koşulları kabul ettiğiniz anlamına gelir.',
  },
  {
    title: 'İletişim',
    content: 'Kullanım koşulları hakkındaki sorularınız, görüş ve önerileriniz için bizimle iletişime geçebilirsiniz.',
    email: contactEmail,
  },
];
---

<Layout
  title="iAkçe — Kullanım Koşulları"
  description="iAkçe uygulaması kullanım koşulları ve hizmet şartları."
  ogImage="/images/logo-iakce.png"
>
  <Header />

  <main class="doc-page">

    <section class="doc-hero">
      <div class="doc-hero-inner">
        <a href="/iakce" class="doc-app-link">
          <img src="/images/logo-iakce.png" alt="iAkçe" class="doc-app-logo" />
          <span class="doc-app-name">iAkçe</span>
        </a>
        <h1 class="doc-title">Kullanım Koşulları</h1>
        <p class="doc-date">Son güncelleme: <span style={`color:${accent};`}>{lastUpdated}</span></p>
        <p class="doc-intro">iAkçe'yi kullanmadan önce bu koşulları okumanızı rica ederiz.</p>
      </div>
    </section>

    <div class="doc-body">
      {sections.map((s, i) => (
        <div class="doc-section">
          <div class="doc-num-wrap" style={`background:${accent}18; border:1px solid ${accent}30;`}>
            <span class="doc-num" style={`color:${accent};`}>{i + 1}</span>
          </div>
          <div class="doc-content">
            <h2>{s.title}</h2>
            <p>{s.content}</p>
            {s.link && (
              <a href={s.link.href} target="_blank" rel="noopener noreferrer" class="doc-link" style={`color:${accent};`}>
                {s.link.text}
              </a>
            )}
            {s.email && (
              <a href={`mailto:${s.email}`} class="doc-link" style={`color:${accent};`}>
                {s.email}
              </a>
            )}
          </div>
        </div>
      ))}

      <div class="doc-footer-links">
        <a href="/iakce/privacy" style={`color:${accent};`}>Gizlilik Politikası →</a>
      </div>

      <div class="doc-back">
        <a href="/iakce">← iAkçe'ye Dön</a>
      </div>
    </div>

  </main>

  <Footer />
</Layout>

<style>
  .doc-page { padding-top: 48px; }

  .doc-hero {
    padding: 64px 24px 56px;
    text-align: center;
    background: var(--bg-section-alt);
    border-bottom: 1px solid var(--border-faint);
  }
  .doc-hero-inner {
    max-width: 640px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 14px;
  }
  .doc-app-link {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none; margin-bottom: 4px;
  }
  .doc-app-logo { width: 44px; height: 44px; border-radius: 10px; }
  .doc-app-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem; font-weight: 600;
    color: var(--color-text);
  }
  .doc-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700; line-height: 1.2;
    color: var(--color-text);
  }
  .doc-date { font-size: 0.875rem; color: var(--color-subtle); }
  .doc-intro {
    font-size: 0.95rem; color: var(--color-muted);
    line-height: 1.7; max-width: 500px;
  }

  .doc-body {
    max-width: 720px; margin: 0 auto;
    padding: 48px 24px 80px;
  }
  .doc-section {
    display: flex; gap: 20px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border-faint);
  }
  .doc-section:last-of-type { border-bottom: none; }

  .doc-num-wrap {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 2px;
  }
  .doc-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem; font-weight: 700;
  }
  .doc-content { flex: 1; }
  .doc-content h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem; font-weight: 600;
    color: var(--color-text); margin-bottom: 10px;
  }
  .doc-content p {
    font-size: 0.9rem; color: var(--color-muted); line-height: 1.75;
  }
  .doc-link {
    display: inline-block; margin-top: 10px;
    font-size: 0.9rem; font-weight: 500;
    text-decoration: none; transition: opacity 0.15s ease;
  }
  .doc-link:hover { opacity: 0.7; }

  .doc-footer-links {
    margin-top: 48px; text-align: center;
    font-size: 0.875rem; font-weight: 500;
  }
  .doc-footer-links a { text-decoration: none; transition: opacity 0.15s; }
  .doc-footer-links a:hover { opacity: 0.7; }

  .doc-back { margin-top: 16px; text-align: center; }
  .doc-back a {
    font-size: 0.875rem; color: var(--color-subtle);
    text-decoration: none; transition: color 0.15s ease;
  }
  .doc-back a:hover { color: var(--color-muted); }
</style>
